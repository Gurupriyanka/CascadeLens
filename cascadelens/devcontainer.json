{
  "name": "CascadeLens",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  },
  "secrets": {
    "OPENAI_API_KEY": {
      "description": "OpenAI API key used by the CascadeLens agents"
    }
  }
}
